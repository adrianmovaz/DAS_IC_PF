generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./das.db"
}

model Reading {
  id        Int      @id @default(autoincrement())
  seq       Int
  tMs       Int
  code      Int
  voltage   Float
  lux       Float
  createdAt DateTime @default(now())

  @@index([createdAt])
}
